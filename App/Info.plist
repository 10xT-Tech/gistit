<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Gist It</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>tech.10xt.englishhelper</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>englishhelper</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CLAUDE_API_KEY</key>
	<string>$(CLAUDE_API_KEY)</string>
	<key>CLAUDE_MODEL</key>
	<string>$(CLAUDE_MODEL)</string>
	<key>CLAUDE_FAST_MODEL</key>
	<string>$(CLAUDE_FAST_MODEL)</string>
	<key>SONIOX_API_KEY</key>
	<string>$(SONIOX_API_KEY)</string>
	<key>BACKEND_URL</key>
	<string>$(BACKEND_URL)</string>
	<key>BACKEND_DEV_TOKEN</key>
	<string>$(BACKEND_DEV_TOKEN)</string>
	<key>SONIOX_MODEL</key>
	<string>$(SONIOX_MODEL)</string>
	<!-- Online translation keeps listening with the app backgrounded / screen locked. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Live Activity: the running online-translation session on the Lock Screen (recording
	     indicator + pause/stop), like Voice Memos. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>AMPLITUDE_API_KEY</key>
	<string>$(AMPLITUDE_API_KEY)</string>
	<key>SENTRY_DSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>The camera lets you point at English text to translate it instantly.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Gist It listens through the microphone to hear what you want to say.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pick a photo containing English text to translate it.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Speech recognition turns your spoken Russian into text to translate.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
