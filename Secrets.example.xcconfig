// Secrets.example.xcconfig — TEMPLATE (committed).
//
// Copy to `Secrets.xcconfig` (gitignored) at the repo root and fill in real values:
//     cp Secrets.example.xcconfig Secrets.xcconfig
//
// These are injected into the app's Info.plist at build time and read by AppConfig.
// NOTE: a key embedded in a built app is extractable — fine for personal/dev use; a production
// build would proxy Claude through a backend instead.

CLAUDE_API_KEY = sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL = claude-sonnet-5-5

// Amplitude (product analytics) — the API key of the "GistIt" project (org 10xt-329448, EU data
// center: app.eu.amplitude.com → Settings → Projects → GistIt → General → API Key). Client keys
// are write-only ingestion ids, NOT secrets. Omit the line to disable analytics.
AMPLITUDE_API_KEY = xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

// Sentry (crash & error reporting) — DSN of project 10xt/gistit (10xt.sentry.io → gistit → Project
// Settings → Client Keys). NOT a secret: a DSN only lets a client send events. Omit to disable.
// Environments are set by the app itself: production (App Store) / testflight / local (Xcode).
// `$()` keeps xcconfig from reading "//" as a comment.
// SENTRY_DSN = https:/$()/xxxxxxxx@oNNNNNN.ingest.us.sentry.io/NNNNNNN

// Soniox (speech-to-text API, console.soniox.com → Get API key) — for the online-translation feature.
SONIOX_API_KEY = xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

// Optional. The Soniox real-time model for online translation. Defaults to stt-rt-v5 in AppConfig.
// SONIOX_MODEL = stt-rt-v5

// Optional. The fast model used for plain translation (Get it → Translate), for speed.
// Defaults to claude-haiku-5-5 (set in Config/Base.xcconfig) if omitted here.
// CLAUDE_FAST_MODEL = claude-haiku-5-5

// Backend (Backend/ — AWS). When set, the app uses it for Claude and Soniox and the two keys above
// are not needed (Release builds strip them anyway). Value = the stack's BackendUrl output.
// BACKEND_URL = https:/$()/xxxxxxxx.lambda-url.eu-central-1.on.aws

// DEBUG builds on the Simulator only (no App Attest there): must equal `dev_token` in the backend
// secret. Leave unset for device builds; Release builds strip it.
// BACKEND_DEV_TOKEN = 

// Optional. Defaults to https://api.anthropic.com in AppConfig if omitted.
// CLAUDE_BASE_URL = https:/$()/api.anthropic.com
